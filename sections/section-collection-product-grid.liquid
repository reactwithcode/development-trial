{{ 'section-collection-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-product-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign has_filters = false
  if collection.filters.size > 0
    assign has_filters = true
  endif
  assign has_active_filters = false
  for filter in collection.filters
    if filter.active_values.size > 0
      assign has_active_filters = true
    endif
    if filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign has_active_filters = true
      endif
    endif
  endfor
-%}

<collection-product-grid class="cpg" id="cpg-{{ section.id }}" data-section-id="{{ section.id }}">

  {%- comment -%} ── Toolbar ── {%- endcomment -%}
  <div class="cpg__toolbar" data-cpg-region="toolbar">
    <div class="cpg__toolbar-inner">
      {%- if has_filters -%}
        <button
          class="cpg__filter-btn"
          type="button"
          aria-expanded="false"
          aria-controls="cpg-drawer-{{ section.id }}"
          data-cpg-filter-btn
        >
          {{ 'icon-filter.svg' | inline_asset_content }}
          <span>Filters</span>
        </button>
      {%- else -%}
        <div></div>
      {%- endif -%}

      <div class="cpg__toolbar-right">
        <span class="cpg__count">{{ 'products.facets.product_count_simple' | t: count: collection.products_count }}</span>
        {%- comment -%}
          Figma shows only "Sort by" + chevron. The native select sits invisibly on top of it,
          so it still opens the device's own picker and announces the current choice.
        {%- endcomment -%}
        <div class="cpg__sort-wrap">
          <label class="cpg__sort-label" for="cpg-sort-{{ section.id }}">
            {{- 'products.facets.sort_by' | t -}}
          </label>
          <span class="cpg__sort-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" focusable="false">
              <path d="M4.16675 7.08337L10.0001 12.9167L15.8334 7.08337" stroke="currentColor"/>
            </svg>
          </span>
          <select
            class="cpg__sort-select"
            id="cpg-sort-{{ section.id }}"
            name="sort_by"
            data-cpg-sort
          >
            {%- for option in collection.sort_options -%}
              <option
                value="{{ option.value }}"
                {%- if option.value == sort_by %} selected{%- endif -%}
              >{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ── Active filter chips ── {%- endcomment -%}
  <div data-cpg-region="active">
  {%- if has_active_filters -%}
    <div class="cpg__active-filters">
      {%- for filter in collection.filters -%}
        {%- for active_value in filter.active_values -%}
          <a href="{{ active_value.url_to_remove }}" class="cpg__active-chip" data-cpg-link>
            <span>{{ active_value.label }}</span>
            {{ 'icon-close.svg' | inline_asset_content }}
          </a>
        {%- endfor -%}
      {%- endfor -%}
      <a href="{{ collection.url }}" class="cpg__active-clear" data-cpg-link>Clear all</a>
    </div>
  {%- endif -%}
  </div>

  {%- comment -%} ── Product grid + pagination ── {%- endcomment -%}
  <div class="cpg__results" data-cpg-region="results">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="cpg__grid">
      {%- for product in collection.products -%}
        {%- liquid
          assign discount_pct = 0
          if product.compare_at_price > product.price
            assign price_diff = product.compare_at_price | minus: product.price
            assign discount_pct = price_diff | times: 100 | divided_by: product.compare_at_price
          endif
          assign is_new_in = false
          if product.tags contains 'new-in'
            assign is_new_in = true
          endif
          assign is_low_stock = false
          if product.total_inventory > 0 and product.total_inventory <= 5
            assign is_low_stock = true
          endif
        -%}
        <div class="cpg__card">
          <div class="cpg__card-media">
            <a href="{{ product.url | within: collection }}" class="cpg__card-img-link{% if product.media[1].preview_image %} cpg__card-img-link--has-secondary{% endif %}" tabindex="-1" aria-hidden="true">
              {%- if product.featured_image -%}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag:
                    class: 'cpg__card-img',
                    loading: 'lazy',
                    widths: '400, 600, 800'
                }}
                {%- comment -%} Second image fades in on hover (desktop only, see CSS) {%- endcomment -%}
                {%- assign secondary_image = product.media[1].preview_image -%}
                {%- if secondary_image -%}
                  {{
                    secondary_image
                    | image_url: width: 800
                    | image_tag:
                      class: 'cpg__card-img cpg__card-img--secondary',
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      alt: ''
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'cpg__card-img cpg__card-img--placeholder' }}
              {%- endif -%}
            </a>

            {%- if discount_pct > 0 -%}
              <div class="cpg__badge cpg__badge--sale" aria-label="-{{ discount_pct }}%">
                -{{ discount_pct }}%
              </div>
            {%- endif -%}

            {%- if is_new_in -%}
              <div class="cpg__badge cpg__badge--strip" aria-label="New In">
                <span class="cpg__badge-icon" aria-hidden="true">{{ 'icon-sparkle-minimal.svg' | inline_asset_content }}</span>
                <span class="cpg__badge-text">NEW IN</span>
              </div>
            {%- elsif is_low_stock -%}
              <div class="cpg__badge cpg__badge--strip" aria-label="Low stock">
                <span class="cpg__badge-icon" aria-hidden="true">{{ 'icon-fire.svg' | inline_asset_content }}</span>
                <span class="cpg__badge-text">LOW STOCK</span>
              </div>
            {%- endif -%}
          </div>

          <div class="cpg__card-info">
            <a href="{{ product.url | within: collection }}" class="cpg__card-name">{{ product.title }}</a>
            <div class="cpg__card-price">
              {%- if product.compare_at_price > product.price -%}
                <span class="cpg__card-price--sale">{{ product.price | money }}</span>
                <s class="cpg__card-price--compare">{{ product.compare_at_price | money }}</s>
              {%- else -%}
                <span class="cpg__card-price--regular">{{ product.price | money }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <p class="cpg__empty">No products match your selection.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- capture chevron_left -%}
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M12.9167 4.16675L7.08337 10.0001L12.9167 15.8334" stroke="currentColor"/>
        </svg>
      {%- endcapture -%}
      {%- capture chevron_right -%}
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M7.08329 4.16675L12.9166 10.0001L7.08329 15.8334" stroke="currentColor"/>
        </svg>
      {%- endcapture -%}

      <nav class="cpg__pagination" aria-label="{{ 'general.pagination.label' | t }}">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="cpg__page-btn" aria-label="{{ 'general.pagination.previous' | t }}">
            {{- chevron_left -}}
          </a>
        {%- else -%}
          <span class="cpg__page-btn cpg__page-btn--disabled" aria-hidden="true">{{ chevron_left }}</span>
        {%- endif -%}

        {%- assign current_page_str = paginate.current_page | append: '' -%}
        <div class="cpg__page-nums">
          {%- for part in paginate.parts -%}
            {%- assign part_title_str = part.title | append: '' -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="cpg__page-num" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                {{- part.title -}}
              </a>
            {%- elsif part_title_str == current_page_str -%}
              <span class="cpg__page-num cpg__page-num--active" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                {{- part.title -}}
              </span>
            {%- else -%}
              <span class="cpg__page-num cpg__page-num--ellipsis" aria-hidden="true">
                <span class="cpg__page-dot"></span>
                <span class="cpg__page-dot"></span>
                <span class="cpg__page-dot"></span>
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="cpg__page-btn" aria-label="{{ 'general.pagination.next' | t }}">
            {{- chevron_right -}}
          </a>
        {%- else -%}
          <span class="cpg__page-btn cpg__page-btn--disabled" aria-hidden="true">{{ chevron_right }}</span>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
  </div>

  {%- comment -%} ── Filter overlay ── {%- endcomment -%}
  <div
    class="cpg__overlay"
    aria-hidden="true"
    data-cpg-overlay
  ></div>

  {%- comment -%} ── Filter drawer ── {%- endcomment -%}
  {%- if has_filters -%}
    {%- liquid
      assign active_filter_count = 0
      for filter in collection.filters
        if filter.type == 'price_range'
          if filter.min_value.value or filter.max_value.value
            assign active_filter_count = active_filter_count | plus: 1
          endif
        else
          assign active_filter_count = active_filter_count | plus: filter.active_values.size
        endif
      endfor
    -%}
    <div
      class="cpg__drawer"
      aria-hidden="true"
      id="cpg-drawer-{{ section.id }}"
      role="dialog"
      aria-labelledby="cpg-drawer-title-{{ section.id }}"
      tabindex="-1"
      data-cpg-drawer
    >
      <div class="cpg__drawer-header">
        <h2 class="cpg__drawer-title" id="cpg-drawer-title-{{ section.id }}" data-cpg-region="drawer-title">
          {{- 'products.facets.filters_title' | t -}}
          {%- if active_filter_count > 0 -%}
            <sup class="cpg__count-sup">[{{ active_filter_count }}]</sup>
          {%- endif -%}
        </h2>
        <button
          class="cpg__drawer-close"
          type="button"
          aria-label="{{ 'products.facets.close_filters' | t }}"
          data-cpg-close
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M16.2412 7.75753L7.75589 16.2428M16.2412 16.2428L7.75589 7.75753" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <form
        class="cpg__drawer-form"
        data-cpg-form
        action="{{ collection.url }}"
        method="get"
      >
        <input type="hidden" name="sort_by" value="{{ sort_by }}" data-cpg-sort-input>

        <div class="cpg__drawer-body" data-cpg-region="drawer-body">
          {%- if active_filter_count > 0 -%}
            <div class="cpg__selected">
              <p class="cpg__selected-label">{{ 'products.facets.selected_filters' | t }}</p>
              <div class="cpg__selected-list">
                {%- for filter in collection.filters -%}
                  {%- if filter.type == 'price_range' -%}
                    {%- if filter.min_value.value or filter.max_value.value -%}
                      <a
                        href="{{ filter.url_to_remove }}"
                        class="cpg__selected-chip" data-cpg-link
                        aria-label="{{ 'products.facets.clear_filter' | t }}: {{ filter.label | escape }}"
                      >
                        <span>
                          {{- filter.min_value.value | default: 0 | money }}–
                          {{- filter.max_value.value | default: filter.range_max | money -}}
                        </span>
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                          <path d="M10.8275 5.17169L5.1706 10.8285M10.8275 10.8285L5.1706 5.17169" stroke="currentColor" stroke-width="0.666667" stroke-linecap="square" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    {%- endif -%}
                  {%- else -%}
                    {%- for active_value in filter.active_values -%}
                      <a
                        href="{{ active_value.url_to_remove }}"
                        class="cpg__selected-chip" data-cpg-link
                        aria-label="{{ 'products.facets.clear_filter' | t }}: {{ active_value.label | escape }}"
                      >
                        <span>{{ active_value.label | escape }}</span>
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                          <path d="M10.8275 5.17169L5.1706 10.8285M10.8275 10.8285L5.1706 5.17169" stroke="currentColor" stroke-width="0.666667" stroke-linecap="square" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <div class="cpg__accordions">
            {%- for filter in collection.filters -%}
              {%- liquid
                assign filter_active_count = filter.active_values.size
                if filter.type == 'price_range'
                  assign filter_active_count = 0
                  if filter.min_value.value or filter.max_value.value
                    assign filter_active_count = 1
                  endif
                endif

                assign is_open = false
                if filter_active_count > 0
                  assign is_open = true
                elsif active_filter_count == 0 and forloop.first
                  assign is_open = true
                endif
              -%}
              <div class="cpg__accordion">
                <button
                  class="cpg__accordion-trigger"
                  type="button"
                  aria-expanded="{{ is_open }}"
                  aria-controls="cpg-filter-{{ forloop.index }}-{{ section.id }}"
                  data-cpg-accordion-trigger
                >
                  <span class="cpg__accordion-label">
                    {{- filter.label | escape -}}
                    {%- if filter_active_count > 0 -%}
                      <sup class="cpg__count-sup">[{{ filter_active_count }}]</sup>
                    {%- endif -%}
                  </span>
                  <svg class="cpg__accordion-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                    <path class="cpg__accordion-icon-v" d="M10 5L10 15" stroke="currentColor" stroke-width="1.25" stroke-linecap="square"/>
                    <path d="M15 10L5 10" stroke="currentColor" stroke-width="1.25" stroke-linecap="square"/>
                  </svg>
                </button>

                <div
                  class="cpg__accordion-panel"
                  id="cpg-filter-{{ forloop.index }}-{{ section.id }}"
                >
                  {%- if filter.type == 'list' or filter.type == 'boolean' -%}
                    <ul class="cpg__filter-list" role="list">
                      {%- for filter_value in filter.values -%}
                        <li>
                          <label class="cpg__filter-option{% if filter_value.count == 0 and filter_value.active == false %} is-disabled{% endif %}">
                            <input
                              class="cpg__filter-input"
                              type="radio"
                              name="{{ filter.param_name }}"
                              value="{{ filter_value.value | escape }}"
                              {%- if filter_value.active %} checked{% endif %}
                              {%- if filter_value.count == 0 and filter_value.active == false %} disabled{% endif %}
                            >
                            <span class="cpg__filter-text">{{ filter_value.label | escape }}</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>

                  {%- elsif filter.type == 'price_range' -%}
                    <div class="cpg__price-range">
                      <label class="cpg__price-field">
                        <span>{{ 'products.facets.from' | t }}</span>
                        <input
                          class="cpg__price-input"
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | remove: ',' | round: 0 }}"
                          placeholder="0"
                          {%- if filter.min_value.value %} value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"{% endif %}
                        >
                      </label>
                      <label class="cpg__price-field">
                        <span>{{ 'products.facets.to' | t }}</span>
                        <input
                          class="cpg__price-input"
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | remove: ',' | round: 0 }}"
                          placeholder="{{ filter.range_max | money_without_currency | remove: ',' | round: 0 }}"
                          {%- if filter.max_value.value %} value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"{% endif %}
                        >
                      </label>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="cpg__drawer-footer" data-cpg-region="drawer-footer">
          <a
            href="{{ collection.url }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by }}{% endif %}"
            class="cpg__btn cpg__btn--secondary" data-cpg-link
          >
            {{- 'products.facets.reset' | t -}}
          </a>
          <button type="submit" class="cpg__btn cpg__btn--primary">
            {{- 'products.facets.view_products' | t: count: collection.products_count -}}
          </button>
        </div>
      </form>
    </div>
  {%- endif -%}

</collection-product-grid>

{% schema %}
{
  "name": "Collection Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Collection Product Grid"
    }
  ]
}
{% endschema %}
