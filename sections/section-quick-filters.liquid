{{ 'section-quick-filters.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-filters.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign filter_param = section.settings.filter_param | default: 'filter.p.product_type'
  assign active_values_str = ''
  if collection
    for f in collection.filters
      if f.param_name == filter_param
        for av in f.active_values
          assign active_values_str = active_values_str | append: av.value | append: '||'
        endfor
      endif
    endfor
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<quick-filters
  class="quick-filters color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  data-filter-param="{{ filter_param | escape }}"
  id="quick-filters-{{ section.id }}"
>
  <div class="quick-filters__inner">
    <div class="quick-filters__track-wrapper">
      <ul class="quick-filters__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_val = ''
            if block.type == 'filter_item'
              assign block_val = block.settings.filter_value
            endif
            assign check_token = block_val | append: '||'
            assign is_active = false
            if block.type == 'all' and active_values_str == ''
              assign is_active = true
            elsif block.type == 'filter_item' and active_values_str contains check_token
              assign is_active = true
            endif
          -%}
          <li {{ block.shopify_attributes }} role="listitem">
            <button
              class="quick-filters__btn{% if is_active %} is-active{% endif %}"
              data-filter-value="{{ block_val | escape }}"
              data-active="{{ is_active }}"
              type="button"
            >
              <span
                class="quick-filters__dot{% unless is_active %} quick-filters__dot--hidden{% endunless %}"
                aria-hidden="true"
              ></span>
              <span class="quick-filters__label">
                {%- if block.type == 'all' -%}
                  {{ block.settings.label | default: 'All Products' | escape }}
                {%- else -%}
                  {{ block.settings.label | escape }}
                {%- endif -%}
              </span>
            </button>
          </li>
        {%- endfor -%}
      </ul>

      <div class="quick-filters__fade" aria-hidden="true"></div>

      <button
        class="quick-filters__scroll-btn"
        type="button"
        aria-label="Scroll to more filters"
        tabindex="-1"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
          <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</quick-filters>

{% schema %}
{
  "name": "Quick Filters",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "filter_param",
      "label": "Filter parameter name",
      "default": "filter.p.product_type",
      "info": "The Shopify filter URL parameter to sync with. Apply a filter on your collection, then check the URL to confirm the correct parameter name."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "all",
      "name": "All Products button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All Products"
        }
      ]
    },
    {
      "type": "filter_item",
      "name": "Filter button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Filter"
        },
        {
          "type": "text",
          "id": "filter_value",
          "label": "Filter value",
          "info": "Must match the product type (or filter value) exactly, including capitalisation."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quick Filters",
      "blocks": [
        { "type": "all", "settings": { "label": "All Products" } },
        { "type": "filter_item", "settings": { "label": "Sets", "filter_value": "Sets" } },
        { "type": "filter_item", "settings": { "label": "Jackets", "filter_value": "Jackets" } },
        { "type": "filter_item", "settings": { "label": "Pants", "filter_value": "Pants" } },
        { "type": "filter_item", "settings": { "label": "T Shirts", "filter_value": "T Shirts" } },
        { "type": "filter_item", "settings": { "label": "Shorts", "filter_value": "Shorts" } },
        { "type": "filter_item", "settings": { "label": "Quarter Zips", "filter_value": "Quarter Zips" } },
        { "type": "filter_item", "settings": { "label": "Footwear", "filter_value": "Footwear" } },
        { "type": "filter_item", "settings": { "label": "Junior", "filter_value": "Junior" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
